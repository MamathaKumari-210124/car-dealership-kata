generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     String @default("USER") // "USER" or "ADMIN"
}

model Vehicle {
  id       String @id @default(uuid())
  make     String
  model    String
  category String
  price    Float
  quantity Int
}